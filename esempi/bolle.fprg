<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ordinamento a bolle"/>
        <attribute name="authors" value="Esempi FlowLab"/>
        <attribute name="about" value="Riempie un array con numeri casuali e lo ordina."/>
        <attribute name="saved" value="2026-10-29 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtlc2VtcGk7MjAyNi0xMC0yOSAwODowMDowMCBQTTsx"/>
        <attribute name="edited" value="Zmxvd2xhYjtlc2VtcGk7MjAyNi0xMC0yOSAwODowMDowMCBQTTsx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="DIM" type="Integer" array="False" size="" flowlab-const="True"/>
            <assign variable="DIM" expression="8"/>
            <declare name="dati" type="Integer" array="True" size="DIM"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="Size(dati) - 1" direction="inc" step="1">
                <assign variable="dati[i]" expression="Random(90) + 10"/>
            </for>
            <output expression="&quot;Prima:  &quot;" newline="False"/>
            <call expression="Stampa(dati)"/>
            <call expression="Ordina(dati)"/>
            <output expression="&quot;Dopo:   &quot;" newline="False"/>
            <call expression="Stampa(dati)"/>
        </body>
    </function>
    <function name="Ordina" type="None" variable="">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="i, j, t" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="Size(v) - 2" direction="inc" step="1">
                <for variable="j" start="0" end="Size(v) - 2 - i" direction="inc" step="1">
                    <if expression="v[j] &gt; v[j + 1]">
                        <then>
                            <assign variable="t" expression="v[j]"/>
                            <assign variable="v[j]" expression="v[j + 1]"/>
                            <assign variable="v[j + 1]" expression="t"/>
                        </then>
                        <else/>
                    </if>
                </for>
            </for>
        </body>
    </function>
    <function name="Stampa" type="None" variable="">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="Size(v) - 1" direction="inc" step="1">
                <output expression="v[i] &amp; &quot; &quot;" newline="False"/>
            </for>
            <output expression="&quot;&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
