<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista collegata"/>
        <attribute name="authors" value="Esempi FlowLab"/>
        <attribute name="about" value="Ogni Nodo contiene un valore e il riferimento al nodo successivo (null alla fine). Apri la scheda Variabili ed esegui con Passo per seguire i riferimenti."/>
        <attribute name="saved" value="2026-10-29 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtlc2VtcGk7MjAyNi0xMC0yOSAwODowMDowMCBQTTsx"/>
        <attribute name="edited" value="Zmxvd2xhYjtlc2VtcGk7MjAyNi0xMC0yOSAwODowMDowMCBQTTsx"/>
    </attributes>
    <flowlab-classes>
        <class name="ListaCollegata" parent="" x="40" y="60"/>
        <class name="Nodo" parent="" x="420" y="300">
            <attribute name="valore" type="Integer" array="False" size="" visibility="public" static="False" init=""/>
            <attribute name="prossimo" type="Nodo" array="False" size="" visibility="public" static="False" init=""/>
        </class>
        <class name="Lista" parent="" x="420" y="40">
            <attribute name="testa" type="Nodo" array="False" size="" visibility="private" static="False" init=""/>
            <attribute name="lunghezza" type="Integer" array="False" size="" visibility="private" static="False" init="0"/>
        </class>
    </flowlab-classes>
    <function name="Main" type="None" variable="" flowlab-class="ListaCollegata" flowlab-visibility="public" flowlab-static="True">
        <parameters/>
        <body>
            <declare name="lista" type="Lista" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="lista" expression="new Lista()"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <call expression="lista.aggiungiInTesta(i * i)"/>
            </for>
            <call expression="lista.stampa()"/>
            <output expression="&quot;Contiene 9? &quot; &amp; lista.contiene(9) &amp; &quot; · contiene 10? &quot; &amp; lista.contiene(10)" newline="True"/>
        </body>
    </function>
    <function name="Nodo" type="None" variable="" flowlab-class="Nodo" flowlab-visibility="public" flowlab-static="False" flowlab-ctor="True">
        <parameters>
            <parameter name="v" type="Integer" array="False"/>
            <parameter name="dopo" type="Nodo" array="False"/>
        </parameters>
        <body>
            <assign variable="valore" expression="v"/>
            <assign variable="prossimo" expression="dopo"/>
        </body>
    </function>
    <function name="aggiungiInTesta" type="None" variable="" flowlab-class="Lista" flowlab-visibility="public" flowlab-static="False">
        <parameters>
            <parameter name="v" type="Integer" array="False"/>
        </parameters>
        <body>
            <assign variable="testa" expression="new Nodo(v, testa)"/>
            <assign variable="lunghezza" expression="lunghezza + 1"/>
        </body>
    </function>
    <function name="contiene" type="Boolean" variable="trovato" flowlab-class="Lista" flowlab-visibility="public" flowlab-static="False">
        <parameters>
            <parameter name="v" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="trovato" type="Boolean" array="False" size=""/>
            <declare name="n" type="Nodo" array="False" size=""/>
            <assign variable="trovato" expression="false"/>
            <assign variable="n" expression="testa"/>
            <while expression="n != null and not trovato">
                <if expression="n.valore = v">
                    <then>
                        <assign variable="trovato" expression="true"/>
                    </then>
                    <else/>
                </if>
                <assign variable="n" expression="n.prossimo"/>
            </while>
        </body>
    </function>
    <function name="stampa" type="None" variable="" flowlab-class="Lista" flowlab-visibility="public" flowlab-static="False">
        <parameters/>
        <body>
            <declare name="n" type="Nodo" array="False" size=""/>
            <assign variable="n" expression="testa"/>
            <output expression="&quot;Lista (&quot; &amp; lunghezza &amp; &quot; elementi): &quot;" newline="False"/>
            <while expression="n != null">
                <output expression="n.valore &amp; &quot; &quot;" newline="False"/>
                <assign variable="n" expression="n.prossimo"/>
            </while>
            <output expression="&quot;&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
