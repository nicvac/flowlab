<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Euclid's GCD"/>
        <attribute name="authors" value="FlowLab examples"/>
        <attribute name="about" value="Greatest common divisor with the algorithm of successive divisions."/>
        <attribute name="saved" value="2026-11-17 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
        <attribute name="edited" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
    </attributes>
    <flowlab-stages active="0" collapsed="True">
        <stage file="gcd_ice.flstage">
            <bind slot="a" variable="Main.a"/>
            <bind slot="b" variable="Main.b"/>
            <bind slot="r" variable="Main.r"/>
        </stage>
        <stage file="gcd.flstage">
            <bind slot="a" variable="Main.a"/>
            <bind slot="b" variable="Main.b"/>
            <bind slot="r" variable="Main.r"/>
        </stage>
    </flowlab-stages>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, r" type="Integer" array="False" size=""/>
            <comment text="Euclid's algorithm: while b is not zero, the pair (a, b) becomes (b, a mod b).&#10;When b is zero, a contains the greatest common divisor."/>
            <output expression="&quot;First number&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;Second number&quot;" newline="True"/>
            <input variable="b"/>
            <while expression="b != 0">
                <assign variable="r" expression="a mod b"/>
                <assign variable="a" expression="b"/>
                <assign variable="b" expression="r"/>
            </while>
            <output expression="&quot;GCD = &quot; &amp; a" newline="True"/>
        </body>
    </function>
</flowgorithm>
